singleton ShaderData( Downscale2x_Shader )
{
   DXVertexShaderFile 	= $Core::CommonShaderPath @ "/postFX/postFxV.hlsl";
   DXPixelShaderFile 	= "./hbaoDownscaleP.hlsl";   
   
   samplerNames[0] = "$deferredMap";
   
   pixVersion = 3.0;
};

singleton ShaderData( HBAO_Shader )
{
   DXVertexShaderFile 	= "./hbaoV.hlsl";
   DXPixelShaderFile 	= "./hbaoP.hlsl";   
   
   samplerNames[0] = "$inputTex";
   
   pixVersion = 3.0;
};

singleton GFXStateBlockData( HBAO_Downscale_StateBlock )
{
   samplersDefined = true;
   samplerStates[0] = SamplerClampLinear;
};

singleton GFXStateBlockData( HBAO_StateBlock )
{
   samplersDefined = true;
   samplerStates[0] = SamplerClampPoint;
};

function HBAOPostFX::setShaderConsts( %this )
{
}

function HBAOPostFX::preProcess( %this )
{
   if (%this.tmpFov != $cameraFov)
   {
      %this.tmpFov = $cameraFov;
      %tanHalfFOVY = mTan(mDegtoRad(%this.tmpFov) * 0.5);
      
      %this->occlusion.setShaderConst("$tanHalfFovY", %tanHalfFOVY);
   }
}

function HBAOPostFX::onAdd(%this)
{
   //Register the postFX with the manager
   PostFXManager.registerPostEffect(%this);
}

function HBAOPostFX::onEnabled( %this )
{
   return true;
}

function HBAOPostFX::onDisabled( %this )
{
   return true;
}

singleton PostEffect( HBAOPostFX )
{
   enabled = false;
   allowReflectPass = false;
     
   //renderTime = "PFXBeforeBin";
   //renderBin = "ProbeBin";   
   //renderPriority = 10;

   shader = Downscale2x_Shader;
   stateBlock = HBAO_Downscale_StateBlock;
   texture[0] = "#deferred";
   target = "#downscaled_2x";
   targetScale = "0.5 0.5";
   targetFormat = "GFXFormatR16G16B16A16f";

   new PostEffect()
   {
      internalName = "occlusion";
      allowReflectPass = false;

      shader = HBAO_Shader;
      stateBlock = HBAO_StateBlock;
      texture[0] = "#downscaled_2x";
      target = "#hbaoRaw";
      targetFormat = "GFXFormatL8";
   };

   new PostEffect()
   {
      allowReflectPass = false;

      shader = PFX_PassthruShader;
      stateBlock = HBAO_StateBlock;
      texture[0] = "#hbaoRaw";
      target = "$backBuffer";
   };
};
